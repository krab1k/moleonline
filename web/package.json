{
  "name": "moleonline-web",
  "version": "3.0.0",
  "description": "",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "build-dev": "vite build --mode development --minify false --sourcemap",
    "preview": "vite preview --mode development",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --skipLibCheck --incremental --tsBuildInfoFile node_modules/.cache/tsbuildinfo",
    "api-types": "openapi-typescript ../backend/openapi.json -o sources/src/MoleAPISchema.d.ts"
  },
  "main": "index.js",
  "typings": "index.d.ts",
  "author": "Dominik Tousek tousekdominik@gmail.com>",
  "homepage": "https://moleonline.biodata.ceitec.cz",
  "keywords": [],
  "license": "MIT",
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.2",
    "molstar": "^4.18.0",
    "nanoid": "^6.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/bootstrap": "^5.2.11",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "openapi-typescript": "6.7.6",
    "sass": "1.106.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
