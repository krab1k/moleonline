# The production instance: on its machine, `ln -s deploy/production.env .env` in the repository's root
COMPOSE_FILE=compose.yaml:compose.production.yaml
# the domains the site is served on
SERVER_NAMES="moleonline.biodata.ceitec.cz moleonline.cz"
# the certificate covering them, /etc/letsencrypt/live/<CERT_NAME>; certbot names it after the first domain issued
CERT_NAME=moleonline.biodata.ceitec.cz
