    "/sessions/{session_id}/jobs/{number}/results/{format}": {
      "get": {
        "tags": [
          "jobs"
        ],
        "summary": "Get Job Result",
        "description": "A result of the job: data (MOLE's data.json, what the web shows), report (a zip of all), pymol, chimera, vmd\n(scripts of the viewers), pdb (a zip of the tunnels' profiles), membrane (of a pore job, also when MOLE then\nfailed). Only a finished job has results.",
        "operationId": "get_job_result",
        "parameters": [
