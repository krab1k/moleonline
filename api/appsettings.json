{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "IncludeScopes": true,
        "TimestampFormat": "yyyy-MM-dd HH:mm:ss "
      }
    }
  },
  "Config": {
    "CSA": "Resources/mcsa_sites.csv.gz",
    "WorkingDirectory": "/data/computations",
    "MaxConcurentComputations": 4,
    "MaxComputationMinutes": 30,
    "MOLE": "/opt/mole2/mole2",
    "Pores": "/opt/pores/bin/pores"
  }
}
