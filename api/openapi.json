    "/sessions/{session_id}/active-sites": {
      "get": {
        "tags": [
          "sessions"
        ],
        "summary": "Get Active Sites",
        "description": "Active sites of the PDB entry from M-CSA (https://www.ebi.ac.uk/thornton-srv/m-csa/, CC BY 4.0), one per\ncopy, as tunnel starting points; none for an uploaded structure",
        "operationId": "get_active_sites",
