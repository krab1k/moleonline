# HTTPS for the domains in SERVER_NAMES (deploy/*.env); the entrypoint writes this file to conf.d/server.conf,
# filling in the environment's variables
server {
    server_name ${SERVER_NAMES};

    listen 8443 ssl;
    http2 on;
    # copied from certbot's by deploy/certbot-deploy-hook.sh, which reloads nginx when they are renewed
    ssl_certificate /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;

    include /etc/nginx/site.conf;
}

server {
    listen 8080;
    server_name ${SERVER_NAMES};

    # certbot's HTTP challenges (--webroot), written to the host's /var/www/certbot
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# Other host names
server {
    listen 8080 default_server;
    return 404;
}
