<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefaultItemExcludes>$(DefaultItemExcludes);tools/**;tests/**</DefaultItemExcludes> <!-- the pores tool is a separate Python project, the tests a separate project -->
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled> <!-- no web.config, it is for IIS -->
  </PropertyGroup>

  <ItemGroup>
    <!-- runs on Linux only (container) -->
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
      <_Parameter1>linux</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="10.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Resources/mcsa_sites.csv.gz"> <!-- active sites from M-CSA, offered as tunnel starting points (tools/mcsa/convert.py) -->
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
