<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefaultItemExcludes>$(DefaultItemExcludes);tools/**</DefaultItemExcludes> <!-- the pores tool is a separate Python project -->
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled> <!-- no web.config, it is for IIS -->
  </PropertyGroup>

  <ItemGroup>
    <!-- runs on Linux only (container) -->
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
      <_Parameter1>linux</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="10.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Resources/CSA_2_0_121113.txt"> <!-- Catalytic Site Atlas 2.0 (EBI, 2013): active sites offered as tunnel starting points -->
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
