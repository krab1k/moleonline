          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Report"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CSAResidue": {
        "properties": {
          "Name": {
            "type": "string",
            "title": "Name"
          },
          "Chain": {
            "type": "string",
            "title": "Chain"
          },
          "SequenceNumber": {
            "type": "integer",
            "title": "Sequencenumber"
          }
        },
        "type": "object",
        "required": [
          "Name",
          "Chain",
          "SequenceNumber"
        ],
        "title": "CSAResidue"
      },
      "CompInfo": {
        "properties": {
          "ComputationId": {
            "type": "string",
            "title": "Computationid"
          },
          "UserStructure": {
            "type": "boolean",
            "title": "Userstructure"
          },
          "PdbId": {
            "type": "string",
            "title": "Pdbid"
          },
          "AssemblyId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Assemblyid"
          },
          "Submissions": {
            "items": {
              "$ref": "#/components/schemas/Submission"
            },
            "type": "array",
            "title": "Submissions"
          }
        },
        "type": "object",
        "required": [
          "ComputationId",
          "UserStructure",
          "PdbId",
          "AssemblyId",
          "Submissions"
        ],
        "title": "CompInfo"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MoleCavity": {
        "properties": {
          "IgnoreHETAtoms": {
            "type": "boolean",
            "title": "Ignorehetatoms",
            "default": false
          },
          "IgnoreHydrogens": {
            "type": "boolean",
            "title": "Ignorehydrogens",
            "default": false
          },
          "InteriorThreshold": {
            "type": "number",
            "title": "Interiorthreshold",
            "default": 1.1
          },
          "ProbeRadius": {
            "type": "number",
            "title": "Proberadius",
            "default": 5.0
          }
        },
        "type": "object",
        "title": "MoleCavity"
      },
      "MoleInput": {
        "properties": {
          "SpecificChains": {
            "type": "string",
            "title": "Specificchains",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "MoleInput"
      },
      "MoleOrigin": {
        "properties": {
          "Points": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/MolePoint"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Points"
          },
          "QueryExpression": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Queryexpression"
          },
          "Residues": {
            "anyOf": [
              {
                "items": {
                  "items": {
                    "$ref": "#/components/schemas/MoleResidue"
                  },
                  "type": "array"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Residues"
          }
        },
        "type": "object",
        "title": "MoleOrigin",
        "description": "Each part is optional"
      },
      "MoleParameters": {
        "properties": {
          "Input": {
            "$ref": "#/components/schemas/MoleInput",
            "default": {
              "SpecificChains": ""
            }
          },
          "Cavity": {
            "$ref": "#/components/schemas/MoleCavity",
            "default": {
              "IgnoreHETAtoms": false,
              "IgnoreHydrogens": false,
              "InteriorThreshold": 1.1,
              "ProbeRadius": 5.0
            }
          },
          "Tunnel": {
            "$ref": "#/components/schemas/MoleTunnel",
            "default": {
              "WeightFunction": "VoronoiScale",
              "BottleneckRadius": 1.25,
              "BottleneckTolerance": 3.0,
              "MaxTunnelSimilarity": 0.7,
              "OriginRadius": 5.0,
