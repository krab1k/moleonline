  "components": {
    "schemas": {
      "CSAResidue": {
        "properties": {
          "Name": {
            "type": "string",
            "title": "Name"
          },
          "Chain": {
            "type": "string",
            "title": "Chain"
          },
          "SequenceNumber": {
            "type": "integer",
            "title": "Sequencenumber"
          }
        },
        "type": "object",
        "required": [
          "Name",
          "Chain",
          "SequenceNumber"
        ],
        "title": "CSAResidue"
      },
      "FieldError": {
        "properties": {
          "field": {
            "type": "string",
            "title": "Field"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "field",
          "message"
        ],
        "title": "FieldError"
      },
      "Job": {
        "properties": {
          "number": {
            "type": "integer",
            "title": "Number"
          },
          "type": {
            "type": "string",
            "enum": [
              "tunnels",
              "pores"
            ],
            "title": "Type"
          },
          "state": {
            "$ref": "#/components/schemas/JobState",
            "default": "queued"
          },
          "error": {
            "type": "string",
            "title": "Error",
            "default": ""
          },
          "parameters": {
            "additionalProperties": true,
            "type": "object",
            "title": "Parameters"
          },
          "submitted": {
